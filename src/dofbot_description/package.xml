<?xml version="1.0"?>
<package format="3">
  <name>dofbot_description</name>
  <version>0.0.0</version>
  <description>DOFBOT SE robot model (URDF and meshes), RViz configuration and display launch files.</description>
  <maintainer email="jesugbohunmi23@gmail.com">dev</maintainer>
  <license>Unspecified</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>dofbot_kinematics</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
